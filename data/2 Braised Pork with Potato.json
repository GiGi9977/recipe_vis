utput"}]}, {"id": "S014", "text": "控干", "text_en": "Drain the pork.", "start_char": 181, "end_char": 183, "node_indices": [23, 24], "edge_indices": [15], "node_action_pairs": [{"node_index": 23, "edge_index": 15, "role": "input"}, {"node_index": 24, "edge_index": 15, "role": "output"}]}, {"id": "S015", "text": "再干锅把五花肉煎出油", "text_en": "Fry the pork belly in a dry pan until it releases oil.", "start_char": 184, "end_char": 195, "node_indices": [24, 25, 26], "edge_indices": [16, 17], "node_action_pairs": [{"node_index": 24, "edge_index": 16, "role": "source"}, {"node_index": 25, "edge_index": 16, "role": "receiver"}, {"node_index": 25, "edge_index": 17, "role": "environment"}, {"node_index": 26, "edge_index": 17, "role": "output"}]}, {"id": "S016", "text": "锅内放油", "text_en": "Add oil to the pan.", "start_char": 218, "end_char": 222, "node_indices": [27, 28], "edge_indices": [18], "node_action_pairs": [{"node_index": 27, "edge_index": 18, "role": "source"}, {"node_index": 28, "edge_index": 18, "role": "receiver"}]}, {"id": "S017", "text": "凉油下冰糖", "text_en": "Add the rock sugar to the cool oil.", "start_char": 224, "end_char": 229, "node_indices": [16, 28], "edge_indices": [19], "node_action_pairs": [{"node_index": 16, "edge_index": 19, "role": "source"}, {"node_index": 28, "edge_index": 19, "role": "receiver"}]}, {"id": "S018", "text": "小火熬到枣红色", "text_en": "Cook over low heat until the sugar turns dark reddish brown.", "start_char": 230, "end_char": 237, "node_indices": [28, 30], "edge_indices": [20], "node_action_pairs": [{"node_index": 28, "edge_index": 20, "role": "input"}, {"node_index": 30, "edge_index": 20, "role": "output"}]}, {"id": "S019", "text": "下五花肉翻炒挂色", "text_en": "Add the pork belly and stir-fry it until coated with color.", "start_char": 239, "end_char": 247, "node_indices": [26, 30, 31], "edge_indices": [21, 22], "node_action_pairs": [{"node_index": 26, "edge_index": 21, "role": "source"}, {"node_index": 30, "edge_index": 21, "role": "receiver"}, {"