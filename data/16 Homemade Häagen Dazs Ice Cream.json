ar": 79, "node_indices": [3, 8], "edge_indices": [8], "node_action_pairs": [{"node_index": 3, "edge_index": 8, "role": "input"}, {"node_index": 8, "edge_index": 8, "role": "output"}]}, {"id": "S007", "text": "之后冷藏备用", "text_en": "Then refrigerate and set aside.", "start_char": 80, "end_char": 86, "node_indices": [8, 9], "edge_indices": [9], "node_action_pairs": [{"node_index": 8, "edge_index": 9, "role": "input"}, {"node_index": 9, "edge_index": 9, "role": "output"}]}, {"id": "S008", "text": "淡奶油冷藏后", "text_en": "After refrigerating the whipping cream.", "start_char": 91, "end_char": 97, "node_indices": [10, 11], "edge_indices": [10], "node_action_pairs": [{"node_index": 10, "edge_index": 10, "role": "input"}, {"node_index": 11, "edge_index": 10, "role": "output"}]}, {"id": "S009", "text": "用电动打蛋器打至 8–9 成发", "text_en": "Beat the cream with an electric mixer until it is 80–90% whipped.", "start_char": 98, "end_char": 113, "node_indices": [11, 12], "edge_indices": [11], "node_action_pairs": [{"node_index": 11, "edge_index": 11, "role": "input"}, {"node_index": 12, "edge_index": 11, "role": "output"}]}, {"id": "S010", "text": "10g 糖加入蛋黄", "text_en": "Add 10 g of sugar to the yolk.", "start_char": 118, "end_char": 127, "node_indices": [13, 2], "edge_indices": [12], "node_action_pairs": [{"node_index": 13, "edge_index": 12, "role": "source"}, {"node_index": 2, "edge_index": 12, "role": "receiver"}]}, {"id": "S011", "text": "用打蛋器搅打成蛋黄液", "text_en": "Beat with a whisk to make a yolk mixture.", "start_char": 128, "end_char": 138, "node_indices": [2, 14], "edge_indices": [13], "node_action_pairs": [{"node_index": 2, "edge_index": 13, "role": "input"}, {"node_index": 14, "edge_index": 13, "role": "output"}]}, {"id": "S012", "text": "将蛋黄液分次", "text_en": "Divide the yolk mixture into portions for adding in batches.", "start_char": 143, "end_char": 149, "node_indices": [14, 15, 16], "edge_indices": [14, 15], "node_action_pairs": [{"node_index": 14, "edge_index": 14, "role": "inp