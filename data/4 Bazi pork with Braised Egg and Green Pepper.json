ource"}, {"node_index": 24, "edge_index": 24, "role": "receiver"}]}, {"id": "S018", "text": "八角", "text_en": "Add star anise.", "start_char": 174, "end_char": 176, "node_indices": [24, 28], "edge_indices": [25], "node_action_pairs": [{"node_index": 28, "edge_index": 25, "role": "source"}, {"node_index": 24, "edge_index": 25, "role": "receiver"}]}, {"id": "S019", "text": "香叶", "text_en": "Add bay leaves.", "start_char": 177, "end_char": 179, "node_indices": [24, 29], "edge_indices": [26], "node_action_pairs": [{"node_index": 29, "edge_index": 26, "role": "source"}, {"node_index": 24, "edge_index": 26, "role": "receiver"}]}, {"id": "S020", "text": "桂皮", "text_en": "Add cinnamon.", "start_char": 180, "end_char": 182, "node_indices": [24, 30], "edge_indices": [27], "node_action_pairs": [{"node_index": 30, "edge_index": 27, "role": "source"}, {"node_index": 24, "edge_index": 27, "role": "receiver"}]}, {"id": "S021", "text": "翻炒爆香", "text_en": "Stir-fry until aromatic.", "start_char": 183, "end_char": 187, "node_indices": [24, 31], "edge_indices": [28], "node_action_pairs": [{"node_index": 24, "edge_index": 28, "role": "input"}, {"node_index": 31, "edge_index": 28, "role": "output"}]}, {"id": "S022", "text": "加入 2 勺生抽", "text_en": "Add 2 spoonfuls of light soy sauce.", "start_char": 191, "end_char": 199, "node_indices": [31, 32], "edge_indices": [29], "node_action_pairs": [{"node_index": 32, "edge_index": 29, "role": "source"}, {"node_index": 31, "edge_index": 29, "role": "receiver"}]}, {"id": "S023", "text": "2 勺黄豆酱", "text_en": "Add 2 spoonfuls of soybean paste.", "start_char": 200, "end_char": 206, "node_indices": [31, 33], "edge_indices": [30], "node_action_pairs": [{"node_index": 33, "edge_index": 30, "role": "source"}, {"node_index": 31, "edge_index": 30, "role": "receiver"}]}, {"id": "S024", "text": "1 勺老抽", "text_en": "Add 1 spoonful of dark soy sauce.", "start_char": 207, "end_char": 212, "node_indices": [31, 34], "edge_indices": [31], "node_action_pairs": [{"nod