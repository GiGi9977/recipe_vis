": 15, "edge_index": 22, "role": "receiver"}]}, {"id": "S019", "text": "加入肉和调料", "text_en": "Add the salt with the meat and seasonings.", "start_char": 198, "end_char": 205, "node_indices": [15, 25], "edge_indices": [23], "node_action_pairs": [{"node_index": 25, "edge_index": 23, "role": "source"}, {"node_index": 15, "edge_index": 23, "role": "receiver"}]}, {"id": "S020", "text": "再加入红酒", "text_en": "Then add the red wine.", "start_char": 206, "end_char": 211, "node_indices": [15, 26], "edge_indices": [24], "node_action_pairs": [{"node_index": 26, "edge_index": 24, "role": "source"}, {"node_index": 15, "edge_index": 24, "role": "receiver"}]}, {"id": "S021", "text": "煮约 20–30 分钟", "text_en": "Cook for about 20–30 minutes.", "start_char": 212, "end_char": 223, "node_indices": [15, 27], "edge_indices": [25], "node_action_pairs": [{"node_index": 15, "edge_index": 25, "role": "input"}, {"node_index": 27, "edge_index": 25, "role": "output"}]}, {"id": "S022", "text": "平底锅中融化黄油", "text_en": "Melt the butter in a frying pan.", "start_char": 225, "end_char": 234, "node_indices": [28, 29, 30], "edge_indices": [26, 27], "node_action_pairs": [{"node_index": 28, "edge_index": 26, "role": "source"}, {"node_index": 29, "edge_index": 26, "role": "receiver"}, {"node_index": 29, "edge_index": 27, "role": "environment"}, {"node_index": 30, "edge_index": 27, "role": "output"}]}, {"id": "S023", "text": "慢慢加入面粉", "text_en": "Slowly add the flour.", "start_char": 235, "end_char": 241, "node_indices": [30, 31], "edge_indices": [28], "node_action_pairs": [{"node_index": 31, "edge_index": 28, "role": "source"}, {"node_index": 30, "edge_index": 28, "role": "receiver"}]}, {"id": "S024", "text": "并搅成糊", "text_en": "Stir it into a paste.", "start_char": 241, "end_char": 245, "node_indices": [30, 32], "edge_indices": [29], "node_action_pairs": [{"node_index": 30, "edge_index": 29, "role": "input"}, {"node_index": 32, "edge_index": 29, "role": "output"}]}, {"id": "S025", "text": "再缓缓加入牛奶", "text_en